# 念头盒 NianBox —— 运营数据接收端的 Cloudflare 配置模板。
#
# 用法：
#   1. 把本文件复制到仓库根目录，改名为 wrangler.toml；
#   2. 把 REPLACE_WITH_YOUR_DATABASE_ID 换成
#      `wrangler d1 create nianbox-telemetry` 输出的 database_id；
#   3. 两个令牌不要写在这里，用 wrangler secret put 存进 Cloudflare：
#        wrangler secret put INGEST_KEY  --name nianbox-telemetry
#        wrangler secret put ADMIN_TOKEN --name nianbox-telemetry
#   4. wrangler d1 execute nianbox-telemetry --remote --file=server/schema.sql
#   5. wrangler deploy --name nianbox-telemetry
#
# 详细步骤见 server/README.md。

name = "nianbox-telemetry"
main = "server/telemetry-worker.js"
# 固定一个已经发布的兼容日期，避免 Cloudflare 默认值变化带来行为差异。
compatibility_date = "2024-11-01"

[vars]
# 「一天」按哪个时区折算。默认东八区；改这里不需要重新部署前端。
TZ_OFFSET_HOURS = "8"

[[d1_databases]]
binding = "DB"
database_name = "nianbox-telemetry"
database_id = "REPLACE_WITH_YOUR_DATABASE_ID"

# 可选：绑定自定义域名，这样接口地址更像自己的服务。
# routes = [{ pattern = "nianbox-api.example.com", custom_domain = true }]

[observability]
# 只记录请求元信息（状态码、耗时），不记录请求体，因此不会碰到用户数据。
enabled = true

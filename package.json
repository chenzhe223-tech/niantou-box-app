{
  "name": "niantou-box",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "念头盒 NianBox | Idea Inbox - 个人灵感捕捉与创意项目种子库",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "verify": "tsc --noEmit && vitest run --configLoader native && vite build --configLoader native",
    "verify:site": "node scripts/verify-site-integration.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
